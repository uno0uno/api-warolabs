							"raw": "{\n    \"search\": \"adiciones\",\n    \"limit\": 20\n}"
						},
						"url": {
							"raw": "{{base_url}}/v1/menu/modifiers",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"v1",
								"menu",
								"modifiers"
							]
						},
						"description": "Ejemplo de busqueda de grupos de modificadores por nombre."
					},
					"response": []
				}
			],
			"description": "Endpoints para consultar el menu: productos, recetas base y modificadores."
		},
		{
			"name": "Tests",
			"item": [
