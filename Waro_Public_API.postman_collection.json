						"body": {
							"mode": "raw",
							"raw": "{\n    \"isAvailable\": true,\n    \"limit\": 50,\n    \"includeIngredients\": true,\n    \"includeRecipeBases\": false,\n    \"includeModifiers\": false\n}"
						},
						"url": {
							"raw": "{{base_url}}/v1/menu/products",
							"host": [
