							"raw": "{{base_url}}/v1/sales",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"v1",
								"sales"
							]
						},
						"description": "Prueba usando el header X-API-Key en lugar de Authorization Bearer."
					},
					"response": []
				}
			],
			"description": "Requests de prueba para validar autenticacion."
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"pm.test(\"Response status is valid\", function () {",
					"    pm.expect(pm.response.code).to.be.oneOf([200, 401, 403, 404, 422]);",
					"});",
					"",
					"pm.test(\"Response is JSON\", function () {",
					"    pm.response.to.be.json;",
					"});",
					"",
					"if (pm.response.code === 200) {",
					"    pm.test(\"Response has success field\", function () {",
					"        var jsonData = pm.response.json();",
					"        pm.expect(jsonData).to.have.property('success');",
					"        pm.expect(jsonData.success).to.be.true;",
					"    });",
					"}"
				]
			}
		}
	]
}
