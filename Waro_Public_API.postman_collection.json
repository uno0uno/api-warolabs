							"raw": "{\n    \"limit\": 100,\n    \"offset\": 0,\n    \"status\": \"completed\",\n    \"dateFrom\": \"2025-01-01\",\n    \"dateTo\": \"2025-12-31\",\n    \"sortField\": \"order_date\",\n    \"sortDirection\": \"desc\",\n    \"timezone\": \"America/Bogota\"\n}"
