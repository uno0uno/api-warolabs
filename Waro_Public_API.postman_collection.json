{
	"info": {
		"_postman_id": "waro-public-api-v1",
		"name": "Waro Colombia - Public API (Token Auth)",
		"description": "Public endpoints for Waro Colombia using API Token authentication.\n\n## Setup\n1. Import the environment \"Waro Colombia - Local\"\n2. Configure the `api_token` variable with your token generated in /integraciones\n\n## Required Scopes\n- `orders:read` or `read` for sales endpoints\n- `menu:read` or `read` for menu endpoints",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{api_token}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "Sales",
			"item": [
				{
					"name": "List Sales",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"limit\": 50,\n    \"offset\": 0,\n    \"sortField\": \"order_date\",\n    \"sortDirection\": \"desc\",\n    \"timezone\": \"America/Bogota\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/v1/sales",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"v1",
								"sales"
							]
						},
						"description": "Get the list of sales for the tenant.\n\n**Required scope:** `orders:read` or `read`\n\n**Available parameters:**\n- `limit`: 1-250 (default: 50)\n- `offset`: pagination (default: 0)\n- `paymentMethod`: cash, card, digital\n- `status`: completed, cancelled, pending\n- `sortField`: order_number, order_date, total_amount, customer_name, payment_method\n- `sortDirection`: asc, desc\n- `dateFrom`: YYYY-MM-DD\n- `dateTo`: YYYY-MM-DD\n- `timezone`: IANA timezone (default: America/Bogota)"
					},
					"response": []
				},
				{
					"name": "List Sales - With Filters",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"limit\": 100,\n    \"offset\": 0,\n    \"status\": \"completed\",\n    \"dateFrom\": \"2025-01-01\",\n    \"dateTo\": \"2025-12-31\",\n    \"sortField\": \"order_date\",\n    \"sortDirection\": \"desc\",\n    \"timezone\": \"America/Bogota\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/v1/sales",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"v1",
								"sales"
							]
						},
						"description": "Example with date filter and completed status."
					},
					"response": []
				},
				{
					"name": "List Sales - By Payment Method",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"paymentMethod\": \"cash\",\n    \"limit\": 20\n}"
						},
						"url": {
							"raw": "{{base_url}}/v1/sales",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"v1",
								"sales"
							]
						},
						"description": "Example filtering by payment method (cash)."
					},
					"response": []
				},
				{
					"name": "List Sales - Different Timezone",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"limit\": 50,\n    \"dateFrom\": \"2025-01-01\",\n    \"dateTo\": \"2025-01-31\",\n    \"timezone\": \"America/Mexico_City\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/v1/sales",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"v1",
								"sales"
							]
						},
						"description": "Example using Mexico timezone for date filters."
					},
					"response": []
				},
				{
					"name": "Sales Metrics",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"timezone\": \"America/Bogota\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/v1/sales/metrics",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"v1",
								"sales",
								"metrics"
							]
						},
						"description": "Get aggregated sales metrics:\n- `totalSales`: Total amount of completed sales\n- `totalOrders`: Total number of orders\n- `completedOrders`: Completed orders\n- `cancelledOrders`: Cancelled orders\n- `pendingOrders`: Pending orders\n- `avgTicket`: Average ticket\n\n**Parameters:**\n- `dateFrom`: YYYY-MM-DD (optional)\n- `dateTo`: YYYY-MM-DD (optional)\n- `timezone`: IANA timezone (default: America/Bogota)\n\n**Required scope:** `orders:read` or `read`"
					},
					"response": []
				},
				{
					"name": "Sales Metrics - By Date Range",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"dateFrom\": \"2025-01-01\",\n    \"dateTo\": \"2025-01-31\",\n    \"timezone\": \"America/Bogota\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/v1/sales/metrics",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"v1",
								"sales",
								"metrics"
							]
						},
						"description": "Sales metrics filtered by date range."
					},
					"response": []
				},
				{
					"name": "Sale Detail",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"orderId\": \"ORDER_UUID_HERE\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/v1/sales/detail",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"v1",
								"sales",
								"detail"
							]
						},
						"description": "Get complete sale detail including:\n- Order information\n- Customer\n- Items with products\n- Modifiers for each item\n\n**Required scope:** `orders:read` or `read`"
					},
					"response": []
				}
			],
			"description": "Endpoints for querying sales (orders) from the tenant."
		},
		{
			"name": "Menu",
			"item": [
				{
					"name": "List Products",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"limit\": 50,\n    \"offset\": 0,\n    \"includeIngredients\": true,\n    \"includeRecipeBases\": true,\n    \"includeModifiers\": true\n}"
						},
						"url": {
							"raw": "{{base_url}}/v1/menu/products",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"v1",
								"menu",
								"products"
							]
						},
						"description": "Get the list of menu products with all their information.\n\n**Required scope:** `menu:read` or `read`\n\n**Available parameters:**\n- `limit`: 1-250 (default: 50)\n- `offset`: pagination (default: 0)\n- `categoryId`: filter by category (UUID)\n- `isAvailable`: filter by availability (true/false)\n- `includeIngredients`: include direct ingredients (default: true)\n- `includeRecipeBases`: include associated recipe bases (default: true)\n- `includeModifiers`: include modifier groups (default: true)\n\n**Response includes:**\n- Product data (name, price, availability, calculated cost)\n- `ingredients[]`: Direct ingredients with quantity and unit\n- `recipeBases[]`: Recipe bases with their ingredients\n- `modifierGroups[]`: Modifier groups with options"
					},
					"response": []
				},
				{
					"name": "List Products - Available Only",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"isAvailable\": true,\n    \"limit\": 50,\n    \"includeIngredients\": true,\n    \"includeRecipeBases\": false,\n    \"includeModifiers\": false\n}"
						},
						"url": {
							"raw": "{{base_url}}/v1/menu/products",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"v1",
								"menu",
								"products"
							]
						},
						"description": "Example filtering only available products, with ingredients only."
					},
					"response": []
				},
				{
					"name": "List Products - By Category",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"categoryId\": \"CATEGORY_UUID_HERE\",\n    \"limit\": 50\n}"
						},
						"url": {
							"raw": "{{base_url}}/v1/menu/products",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"v1",
								"menu",
								"products"
							]
						},
						"description": "Example filtering products by category."
					},
					"response": []
				},
				{
					"name": "List Recipe Bases",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"limit\": 50,\n    \"offset\": 0\n}"
						},
						"url": {
							"raw": "{{base_url}}/v1/menu/recipes",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"v1",
								"menu",
								"recipes"
							]
						},
						"description": "Get the list of recipe bases with their ingredients.\n\n**Required scope:** `menu:read` or `read`\n\n**Available parameters:**\n- `limit`: 1-250 (default: 50)\n- `offset`: pagination (default: 0)\n- `isActive`: filter by active status (true/false)\n\n**Response includes:**\n- Recipe data (name, description, status)\n- `ingredients[]`: List of ingredients with quantity, unit and notes"
					},
					"response": []
				},
				{
					"name": "List Recipe Bases - Active Only",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"isActive\": true,\n    \"limit\": 50\n}"
						},
						"url": {
							"raw": "{{base_url}}/v1/menu/recipes",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"v1",
								"menu",
								"recipes"
							]
						},
						"description": "Example filtering only active recipes."
					},
					"response": []
				},
				{
					"name": "List Modifiers",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"limit\": 50,\n    \"offset\": 0\n}"
						},
						"url": {
							"raw": "{{base_url}}/v1/menu/modifiers",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"v1",
								"menu",
								"modifiers"
							]
						},
						"description": "Get the list of modifier groups with their options.\n\n**Required scope:** `menu:read` or `read`\n\n**Available parameters:**\n- `limit`: 1-250 (default: 50)\n- `offset`: pagination (default: 0)\n\n**Response includes:**\n- Group data (name, min/max quantity, required)\n- `modifiers[]`: Options with price, availability and associated ingredient\n- `associatedProducts[]`: Products that use this group"
					},
					"response": []
				}
			],
			"description": "Endpoints for querying the menu: products, recipe bases and modifiers."
		},
		{
			"name": "Tests",
			"item": [
				{
					"name": "Test - Invalid Token",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "waro_sk_invalid_token",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{}"
						},
						"url": {
							"raw": "{{base_url}}/v1/sales",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"v1",
								"sales"
							]
						},
						"description": "Test with invalid token to verify 401 error response."
					},
					"response": []
				},
				{
					"name": "Test - No Token",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{}"
						},
						"url": {
							"raw": "{{base_url}}/v1/sales",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"v1",
								"sales"
							]
						},
						"description": "Test without token to verify 401 error response."
					},
					"response": []
				},
				{
					"name": "Test - Using X-API-Key Header",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "X-API-Key",
								"value": "{{api_token}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"limit\": 5\n}"
						},
						"url": {
							"raw": "{{base_url}}/v1/sales",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"v1",
								"sales"
							]
						},
						"description": "Test using X-API-Key header instead of Authorization Bearer."
					},
					"response": []
				}
			],
			"description": "Test requests for authentication validation."
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"pm.test(\"Response status is valid\", function () {",
					"    pm.expect(pm.response.code).to.be.oneOf([200, 401, 403, 404, 422]);",
					"});",
					"",
					"pm.test(\"Response is JSON\", function () {",
					"    pm.response.to.be.json;",
					"});",
					"",
					"if (pm.response.code === 200) {",
					"    pm.test(\"Response has success field\", function () {",
					"        var jsonData = pm.response.json();",
					"        pm.expect(jsonData).to.have.property('success');",
					"        pm.expect(jsonData.success).to.be.true;",
					"    });",
					"}"
				]
			}
		}
	]
}
