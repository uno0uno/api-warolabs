					"name": "Test - Token Invalido",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "waro_sk_token_invalido",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{}"
						},
						"url": {
							"raw": "{{base_url}}/v1/sales",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"v1",
								"sales"
							]
						},
						"description": "Prueba con un token invalido para verificar que retorna error 401."
					},
					"response": []
				},
				{
					"name": "Test - Sin Token",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{}"
						},
						"url": {
							"raw": "{{base_url}}/v1/sales",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"v1",
								"sales"
							]
						},
						"description": "Prueba sin token para verificar que retorna error 401."
					},
					"response": []
				},
				{
					"name": "Test - Usando X-API-Key Header",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "X-API-Key",
								"value": "{{api_token}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"limit\": 5\n}"
						},
